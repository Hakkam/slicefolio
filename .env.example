# Canonical public URL used for SEO metadata, sitemap, and Open Graph.
# Example for GitHub Pages: https://hakkam.github.io/slicefolio
SLICEFOLIO_SITE_URL=

# Base path used when the app is hosted below a subdirectory.
# Use / for a root domain, or /slicefolio/ for GitHub project Pages.
SLICEFOLIO_BASE_PATH=/
