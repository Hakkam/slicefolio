{
  "name": "slicefolio-telegram-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/api.ts",
    "dev:bot": "tsx watch src/bot.ts",
    "check": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/api.js",
    "bot": "node dist/bot.js"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.69",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "jszip": "^3.10.1",
    "multer": "^2.0.2",
    "pdfjs-dist": "^4.10.38",
    "telegraf": "^4.16.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
